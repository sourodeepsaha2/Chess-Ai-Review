{
  "name": "chess-ai-review",
  "version": "1.0.0",
  "description": "Production-ready Chess AI Review monorepo containing an extension and a server.",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "build:frontend": "npm run build -w frontend",
    "build:backend": "npm run build -w backend",
    "build": "npm run build --workspaces --if-present",
    "lint:frontend": "npm run lint -w frontend",
    "lint:backend": "npm run lint -w backend",
    "lint": "npm run lint --workspaces --if-present",
    "format:frontend": "npm run format -w frontend",
    "format:backend": "npm run format -w backend",
    "format": "npm run format --workspaces --if-present",
    "clean": "rm -rf node_modules frontend/node_modules backend/node_modules frontend/dist backend/dist backend/build"
  },
  "keywords": [],
  "author": "",
  "license": "MIT"
}
